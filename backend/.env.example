# ==============================================================================
# ClauseIQ Backend Configuration Template
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# Core Application Security
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=generate-a-secure-random-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connections
# Default config uses SQLite. Swap for PostgreSQL in production (e.g. postgresql://user:pass@host:port/dbname)
DATABASE_URL=sqlite:///./clauseiq.db

# Storage Directories
# Paths relative to backend execution directory
UPLOAD_DIR=./uploaded_documents
CHROMA_DB_DIR=./chroma_db

# Artificial Intelligence (LLM & Embeddings)
# Mandatory for production OpenAI parsing. If blank, ClauseIQ runs using realistic Mock Engine fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Administrator Seeding
# Creates this user with admin credentials automatically on startup if not present in the database.
ADMIN_EMAIL=admin@clauseiq.com
ADMIN_PASSWORD=AdminSecurePassword2026!

# Comma-separated frontend origins allowed by CORS (add your Vercel URL here)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
