# ==============================================================================
# ClauseIQ Backend Configuration Template
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# Core Application Security
# Generate a unique value using: openssl rand -hex 32
ENVIRONMENT=development
SECRET_KEY=replace-with-a-unique-32-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connections
# Default config uses SQLite. Swap for PostgreSQL in production (e.g. postgresql://user:pass@host:port/dbname)
DATABASE_URL=sqlite:///./clauseiq.db

# Storage Directories
# Paths relative to backend execution directory
UPLOAD_DIR=./uploaded_documents
CHROMA_DB_DIR=./chroma_db

# Artificial Intelligence (LLM & Embeddings)
# Required for genuine analysis. AI_MODE=mock is explicit development/test mode only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MODE=provider

# PDF and password-reset controls
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=200
PASSWORD_RESET_TTL_MINUTES=30
# disabled (default), console (development only), or smtp
EMAIL_PROVIDER=disabled
RESET_URL_BASE=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional one-time administrator bootstrap. Omit both to disable.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Comma-separated frontend origins allowed by CORS (add your Vercel URL here)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
